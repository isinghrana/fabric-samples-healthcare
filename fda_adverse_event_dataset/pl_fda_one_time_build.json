{
  "properties": {
    "description": "One-time build of the FDA adverse event medallion: download the openFDA files -> JSON (Bronze) -> Silver -> Gold. Every step is restartable; rerunning skips files already downloaded and quarters already loaded.",
    "parameters": {
      "p_quarters": {
        "type": "string",
        "defaultValue": ""
      },
      "p_max_parallel_downloads": {
        "type": "int",
        "defaultValue": 16
      },
      "p_max_parallel_unzips": {
        "type": "int",
        "defaultValue": 8
      },
      "p_overwrite_existing": {
        "type": "bool",
        "defaultValue": false
      },
      "p_files_per_batch": {
        "type": "int",
        "defaultValue": 128
      },
      "p_finalize": {
        "type": "bool",
        "defaultValue": true
      },
      "p_reset": {
        "type": "bool",
        "defaultValue": false
      },
      "p_silver_schema": {
        "type": "string",
        "defaultValue": "silver"
      },
      "p_gold_schema": {
        "type": "string",
        "defaultValue": "gold"
      },
      "p_min_cases": {
        "type": "int",
        "defaultValue": 3
      },
      "p_recent_years": {
        "type": "int",
        "defaultValue": 3
      }
    },
    "activities": [
      {
        "name": "Download Dataset",
        "description": "Download the openFDA drug adverse event zip files and unzip them into the lakehouse Files area.",
        "type": "TridentNotebook",
        "dependsOn": [],
        "policy": {
          "timeout": "1.00:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 300,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "{{notebook:nb_fda_00_download_dataset}}",
          "workspaceId": "{{workspace_id}}",
          "parameters": {
            "p_quarters": {
              "value": {
                "value": "@pipeline().parameters.p_quarters",
                "type": "Expression"
              },
              "type": "string"
            },
            "p_max_parallel_downloads": {
              "value": {
                "value": "@pipeline().parameters.p_max_parallel_downloads",
                "type": "Expression"
              },
              "type": "int"
            },
            "p_max_parallel_unzips": {
              "value": {
                "value": "@pipeline().parameters.p_max_parallel_unzips",
                "type": "Expression"
              },
              "type": "int"
            },
            "p_overwrite_existing": {
              "value": {
                "value": "@pipeline().parameters.p_overwrite_existing",
                "type": "Expression"
              },
              "type": "bool"
            }
          }
        }
      },
      {
        "name": "Load Silver",
        "description": "Parse the openFDA JSON files into Silver Delta tables, deduplicate report versions, optimize.",
        "type": "TridentNotebook",
        "dependsOn": [
          {
            "activity": "Download Dataset",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "2.00:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 300,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "{{notebook:nb_fda_01_silver_load}}",
          "workspaceId": "{{workspace_id}}",
          "parameters": {
            "p_quarters": {
              "value": {
                "value": "@pipeline().parameters.p_quarters",
                "type": "Expression"
              },
              "type": "string"
            },
            "p_files_per_batch": {
              "value": {
                "value": "@pipeline().parameters.p_files_per_batch",
                "type": "Expression"
              },
              "type": "int"
            },
            "p_finalize": {
              "value": {
                "value": "@pipeline().parameters.p_finalize",
                "type": "Expression"
              },
              "type": "bool"
            },
            "p_reset": {
              "value": {
                "value": "@pipeline().parameters.p_reset",
                "type": "Expression"
              },
              "type": "bool"
            },
            "p_silver_schema": {
              "value": {
                "value": "@pipeline().parameters.p_silver_schema",
                "type": "Expression"
              },
              "type": "string"
            }
          }
        }
      },
      {
        "name": "Build Gold",
        "description": "Build the Gold star schema, insight tables and disproportionality signals from Silver.",
        "type": "TridentNotebook",
        "dependsOn": [
          {
            "activity": "Load Silver",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 300,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "{{notebook:nb_fda_02_gold_build}}",
          "workspaceId": "{{workspace_id}}",
          "parameters": {
            "p_silver_schema": {
              "value": {
                "value": "@pipeline().parameters.p_silver_schema",
                "type": "Expression"
              },
              "type": "string"
            },
            "p_gold_schema": {
              "value": {
                "value": "@pipeline().parameters.p_gold_schema",
                "type": "Expression"
              },
              "type": "string"
            },
            "p_min_cases": {
              "value": {
                "value": "@pipeline().parameters.p_min_cases",
                "type": "Expression"
              },
              "type": "int"
            },
            "p_recent_years": {
              "value": {
                "value": "@pipeline().parameters.p_recent_years",
                "type": "Expression"
              },
              "type": "int"
            }
          }
        }
      }
    ]
  }
}
